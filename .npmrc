# Supply-chain hardening: never run dependency install scripts
# (preinstall/install/postinstall), the vector used by Shai-Hulud-style worms.
# esbuild, sharp and workerd resolve their prebuilt platform binaries through
# optionalDependencies, so their install scripts are not needed.
ignore-scripts=true
# Only resolve versions published at least 3 days ago (supported by recent
# npm 11 releases; older npm warns "Unknown project config" and ignores it).
min-release-age=3
