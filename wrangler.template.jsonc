// ⚠️  TEMPLATE — DO NOT INVOKE WRANGLER AGAINST THIS FILE DIRECTLY.
//
// The real `wrangler.jsonc` is generated by `scripts/build-config.mjs`
// (run via `npm run build:config`) which substitutes `__BUILD_HASH__`
// and `__COMMIT_SHA__` and is gitignored. Without that step, wrangler
// has no config file, so manual `wrangler deploy` from a dev machine
// fails fast. CI runs `build:config` before deploy in
// `.github/workflows/deploy.yml`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-remote",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-10-26",
  "compatibility_flags": ["nodejs_compat"],

  // Custom domains. mcp.kaptionai.com is canonical; mcp-ext is retained for
  // existing MCP clients and extension builds.
  "routes": [
    { "pattern": "mcp.kaptionai.com", "custom_domain": true },
    { "pattern": "mcp-ext.kaptionai.com", "custom_domain": true }
  ],

  // Durable Objects
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "RelayMCP"
      },
      {
        "name": "RELAY_ROOM",
        "class_name": "RelayRoom"
      },
      {
        "name": "DEPLOYMENT_CHAIN",
        "class_name": "DeploymentChainDO"
      },
      // mcp-usage-accounting.STORE.1 — Claude and ChatGPT usage: one ledger per account, plus global totals.
      {
        "name": "USAGE_LEDGER",
        "class_name": "UsageLedger"
      },
      {
        "name": "USAGE_TOTALS",
        "class_name": "UsageTotals"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayMCP", "RelayRoom", "DeploymentChainDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["UsageLedger", "UsageTotals"]
    }
  ],

  "observability": {
    "logs": {
      "enabled": true
    }
  },

  // KV Namespaces
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "d8f86606c8e543079ebbdd7d72376a05"
    }
  ],

  "vars": {
    "INTERNAL_API_BASE_URL": "https://api.kaptionai.com",
    // mcp-usage-accounting.STORE.4 — "off" stops recording Claude and ChatGPT usage (kill switch).
    "USAGE_LEDGER_ENABLED": "on",
    "BUILD_HASH": "__BUILD_HASH__",
    "COMMIT_SHA": "__COMMIT_SHA__"
  },

  // Static assets from OpenNext build
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }

  // Named entrypoint InternalRelay (src/internal-relay.ts, mcp.CLOUD_RELAY.18) needs no config here: other
  // workers on this account reach it only through a service binding
  // { "service": "mcp-remote", "entrypoint": "InternalRelay" }. No route serves it.

  // Secrets (set via `wrangler secret put`):
  // - INTERNAL_API_KEY: API key for rest-api OTP endpoint
  // - DEPLOY_API_KEY: API key for transparency chain append
  // - JWT_SECRET: Shared JWT signing secret (same as rest-api, schedule, metadata workers)
  // - PHONE_REF_SECRET: HMAC secret for durable accountRef derivation
  // - EPHEMERAL_STATE_SECRET: Encryption secret for short-lived UI/session state
  // - OPENAI_APPS_CHALLENGE_TOKEN: Exact token issued by the OpenAI plugin portal
  // - OPENAI_REVIEW_PASSWORD_SHA256: SHA-256 hex digest of reviewer password
  // - OPENAI_REVIEW_PHONE: Dedicated synthetic review account phone number
}
